# Multi-stage Dockerfile for TurtleWoW 1.17.2 Core

# -----------------------------------------------------------------------------
# Stage 1: Build Stage
# -----------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    make \
    git \
    g++ \
    libace-dev \
    default-libmysqlclient-dev \
    libssl-dev \
    zlib1g-dev \
    ca-certificates \
    ccache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_STD_MALLOC=ON \
        -DUSE_ANTICHEAT=ON \
        -DUSE_SCRIPTS=ON \
        -DUSE_EXTRACTORS=OFF \
        -DCMAKE_INSTALL_PREFIX=/app && \
    make -j$(nproc) && \
    make install

# -----------------------------------------------------------------------------
# Stage 2: Runtime Stage
# -----------------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libace-dev \
    default-libmysqlclient-dev \
    libssl3 \
    zlib1g \
    netcat \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app /app

RUN mkdir -p /app/etc /app/logs /app/data /app/scripts /app/honor

EXPOSE 3724 8091

CMD ["/bin/bash"]
