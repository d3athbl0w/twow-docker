# Multi-stage Dockerfile for TurtleWoW 1.17.2 Core

# -----------------------------------------------------------------------------
# Stage 1: Build Stage
# -----------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    make \
    git \
    g++ \
    libace-dev \
    default-libmysqlclient-dev \
    libssl-dev \
    zlib1g-dev \
    ca-certificates \
    ccache \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

ARG GIT_REPO="https://github.com/d3athbl0w/twow-1172.git"
ARG GIT_BRANCH="master"

# Copy local build context to inspect if source is provided locally
COPY . /tmp/context/
RUN if [ -n "$GIT_REPO" ]; then \
        echo "Cloning source repository from ${GIT_REPO} (${GIT_BRANCH})..." && \
        git clone --depth 1 -b "${GIT_BRANCH}" "${GIT_REPO}" /src ; \
    elif [ -f /tmp/context/CMakeLists.txt ]; then \
        echo "Using local source from build context..." && \
        cp -a /tmp/context/. /src/ ; \
    else \
        echo "ERROR: No GIT_REPO provided and build context does not contain CMakeLists.txt" && exit 1 ; \
    fi && \
    rm -rf /tmp/context

RUN mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DUSE_STD_MALLOC=ON \
        -DUSE_ANTICHEAT=ON \
        -DUSE_SCRIPTS=ON \
        -DUSE_EXTRACTORS=OFF \
        -DCMAKE_INSTALL_PREFIX=/app && \
    make -j$(nproc) && \
    make install

# Copy SQL directory into build artifact for database updates & migrations
RUN if [ -d /src/sql ]; then cp -r /src/sql /app/sql; fi

# -----------------------------------------------------------------------------
# Stage 2: Runtime Stage
# -----------------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libace-dev \
    default-libmysqlclient-dev \
    libssl3 \
    zlib1g \
    netcat \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app /app

RUN mkdir -p /app/etc /app/logs /app/data /app/scripts /app/honor /app/sql/unused

EXPOSE 3724 8091

CMD ["/bin/bash"]

